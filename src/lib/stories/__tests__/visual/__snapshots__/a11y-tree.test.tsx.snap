// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Дерево доступности (AX) > AX1: грид с сортировкой и выбором — роли, имена, multiselectable, selected 1`] = `
"grid "Data table" multiselectable
  rowgroup
    row "Select all rows Country First Name Last Name"
      columnheader "Select all rows"
        checkbox "Select all rows" checked=mixed
      columnheader "Country"
        button "Sort descending"
      columnheader "First Name"
        button "Sort descending"
      columnheader "Last Name"
        button "Sort descending"
  rowgroup
    row "Select row Pitcairn Islands Jaydon Tremblay"
      gridcell "Select row"
        checkbox "Select row"
      gridcell "Pitcairn Islands"
      gridcell "Jaydon"
      gridcell "Tremblay"
    row "Select row Anguilla Madge Padberg" selected
      gridcell "Select row"
        checkbox "Select row" checked=true
      gridcell "Anguilla"
      gridcell "Madge"
      gridcell "Padberg"
    row "Select row India Marjorie Crona"
      gridcell "Select row"
        checkbox "Select row"
      gridcell "India"
      gridcell "Marjorie"
      gridcell "Crona""
`;

