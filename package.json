{
  "name": "@mstrvtt/tessera",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins.d.ts",
        "default": "./dist/plugins.js"
      },
      "require": {
        "types": "./dist/plugins.d.cts",
        "default": "./dist/plugins.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "check:theme": "node scripts/check-theme-dist.mjs",
    "check:requirements": "node scripts/check-requirements.mjs",
    "check:tree-shaking": "node scripts/check-tree-shaking.mjs",
    "check:browsers": "node scripts/check-browsers.mjs",
    "check:package": "node scripts/check-package.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browsers": "vitest run --config vitest.browsers.config.ts",
    "test:engines": "vitest run --config vitest.engines.config.ts",
    "test:react18": "npm ci --prefix tools/react18 --no-audit --no-fund && vitest run --config vitest.react18.config.ts",
    "perf": "vitest run --config vitest.perf.config.ts && node scripts/perf-report.mjs",
    "perf:report": "node scripts/perf-report.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 17.1",
    "ios_saf >= 17.1",
    "opera >= 97",
    "samsung >= 22",
    "last 1 and_chr version",
    "last 1 op_mob version"
  ],
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-virtual": "^3.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@fontsource/inter": "^5.3.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.14.0",
    "doiuse": "^6.0.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "storybook": "^10.5.5",
    "storybook-addon-pseudo-states": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  }
}
