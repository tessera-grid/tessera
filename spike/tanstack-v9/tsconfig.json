{
  "comment": "Изолированный typecheck спайка против v9-алиаса. Запуск: npx tsc --noEmit -p spike/tanstack-v9/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["commonFeature.ts", "registry.ts", "prototype.tsx"],
  "exclude": ["reactivity.test.ts"]
}
